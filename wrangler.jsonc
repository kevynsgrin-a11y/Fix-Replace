{
  // RepairOrReplace — Cloudflare Worker configuration.
  // A single Worker serves the static frontend (via the Assets binding) and the
  // /api/* compute layer (NPC + Weibull algorithms, CPSC recall lookups).
  //
  // This config deploys OUT OF THE BOX with zero provisioned resources: the
  // Worker degrades gracefully when the optional KV/D1/R2 bindings are absent
  // (result-sharing returns 503, recall lookups skip caching, the cron no-ops).
  // To enable full functionality, create the resources and uncomment the
  // binding blocks below — see docs/DEPLOYMENT.md.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "repair-or-replace",
  "main": "src/worker/index.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],

  // --- Where this Worker is served ------------------------------------------
  // STAGE 1 (current): deploy to the workers.dev URL only, so the Worker can be
  // verified end-to-end while the existing site keeps serving the domain. A
  // custom_domain route rewrites the zone's DNS on deploy, so attaching one
  // before the Worker is proven would cut the live site over to an unverified
  // build — and a failure to attach fails the whole deploy, shipping nothing.
  "workers_dev": true,

  // STAGE 2 (cutover): uncomment to move repair-or-replace.net onto this
  // Worker. Do this only after the workers.dev URL has been verified, and
  // after whatever currently serves the apex + www has been disconnected.
  // "routes": [
  //   { "pattern": "repair-or-replace.net", "custom_domain": true },
  //   { "pattern": "www.repair-or-replace.net", "custom_domain": true }
  // ],

  // Static frontend. The Worker runs first and falls through to these assets
  // for any non-/api route.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },

  "observability": {
    "enabled": true
  },

  // --- Optional resources -----------------------------------------------------
  // Uncomment after creating each resource and pasting its real id.
  //
  // Hot cache + shared-result store (enables /api/report sharing, recall
  // caching, and the daily recall ingestion):
  //   npx wrangler kv namespace create CACHE
  // "kv_namespaces": [
  //   { "binding": "CACHE", "id": "<paste-kv-namespace-id>" }
  // ],
  //
  // Serverless SQL (Phase 2: accounts + appliance inventories):
  //   npx wrangler d1 create repair_or_replace
  // "d1_databases": [
  //   {
  //     "binding": "DB",
  //     "database_name": "repair_or_replace",
  //     "database_id": "<paste-d1-database-id>",
  //     "migrations_dir": "migrations"
  //   }
  // ],
  //
  // Object storage (Phase 3: generated PDF reports):
  //   npx wrangler r2 bucket create repair-or-replace-reports
  // "r2_buckets": [
  //   { "binding": "REPORTS", "bucket_name": "repair-or-replace-reports" }
  // ],

  // Daily worker that ingests fresh CPSC recalls into KV (03:15 UTC).
  // Harmless no-op until the CACHE binding above is enabled.
  "triggers": {
    "crons": ["15 3 * * *"]
  },

  "vars": {
    "DISCOUNT_RATE": "0.05",
    "CPSC_API_BASE": "https://www.saferproducts.gov/RestWebServices/Recall",

    // Browser origins allowed to call /api/*. The presentation layer is
    // deployed separately, so calculation requests are cross-origin. Add any
    // preview host that also needs to call the API.
    "ALLOWED_ORIGINS": "https://repair-or-replace.net,https://www.repair-or-replace.net,http://localhost:3000"
  }
}
