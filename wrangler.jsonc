{
  // RepairOrReplace — Cloudflare Worker configuration.
  // A single Worker serves the static frontend (via the Assets binding) and the
  // /api/* compute layer (NPC + Weibull algorithms, CPSC recall lookups).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "repair-or-replace",
  "main": "src/worker/index.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],

  // Static frontend (Cloudflare Pages-equivalent). The Worker runs first and
  // falls through to these assets for any non-/api route.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },

  "observability": {
    "enabled": true
  },

  // Serverless SQL at the edge: user accounts, saved appliance inventories,
  // and the zip -> BLS labor-rate grid.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "repair_or_replace",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  // Hot cache for slow-changing federal data: CPSC recalls + labor averages.
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "0000000000000000000000000000000000"
    }
  ],

  // Object storage for generated PDF reports (professional tier) + asset images.
  "r2_buckets": [
    {
      "binding": "REPORTS",
      "bucket_name": "repair-or-replace-reports"
    }
  ],

  // Daily worker that ingests fresh CPSC recalls into KV (03:15 UTC).
  "triggers": {
    "crons": ["15 3 * * *"]
  },

  "vars": {
    "DISCOUNT_RATE": "0.05",
    "CPSC_API_BASE": "https://www.saferproducts.gov/RestWebServices/Recall"
  }
}
