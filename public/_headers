# Cloudflare static-asset headers. Static files are served by the Assets
# binding and bypass the Worker, so security + caching headers live here.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; manifest-src 'self'

# Styles and scripts are unhashed and the HTML that references them is
# max-age=0, so these must stay short: a longer TTL lets a returning visitor
# pair new markup with day-old CSS. Revalidation is cheap (304, no body).
/styles/*
  Cache-Control: public, max-age=600, stale-while-revalidate=86400

/scripts/*
  Cache-Control: public, max-age=600, stale-while-revalidate=86400

# Icons and the manifest change only with a rebrand.
/icon.svg
  Cache-Control: public, max-age=604800
/icon-192.png
  Cache-Control: public, max-age=604800
/icon-512.png
  Cache-Control: public, max-age=604800
/icon-maskable-512.png
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/site.webmanifest
  Cache-Control: public, max-age=604800

# Social cards are fetched by scrapers, not browsers. Deliberately NOT
# immutable: every page references them by bare path, so an immutable cache
# would make a banner update unshippable.
/og.png
  Cache-Control: public, max-age=2592000
/social/*
  Cache-Control: public, max-age=2592000
