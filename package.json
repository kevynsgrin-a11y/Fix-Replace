{
  "name": "repair-or-replace",
  "version": "0.1.0",
  "private": true,
  "description": "RepairOrReplace — an evidence-based decision utility that computes whether repairing or replacing a major household appliance is the economically rational choice.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply repair_or_replace --local",
    "db:migrate:remote": "wrangler d1 migrations apply repair_or_replace --remote"
  },
  "keywords": [
    "appliance",
    "repair",
    "replace",
    "calculator",
    "cloudflare",
    "workers",
    "net-present-cost",
    "weibull"
  ],
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240815.0",
    "playwright-core": "^1.61.1",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5",
    "wrangler": "^3.72.0"
  }
}
